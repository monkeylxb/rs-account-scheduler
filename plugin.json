{
  "manifestVersion": 2,
  "publisher": "personal",
  "name": "account-scheduler",
  "displayName": "账号定时启停",
  "version": "0.4.3",
  "description": "用 Cron 安排账号启用与停用，查看执行记录",
  "license": "Apache-2.0",
  "engines": { "codex-proxy-rs": ">=3.54.0, <3.58.0" },
  "main": "bin/account-scheduler",
  "runtime": "trustedProcess",
  "contributes": { "management": { "version": 2 }, "maintenance": {} },
  "configurationSchema": { "type": "object", "properties": {}, "additionalProperties": false },
  "resources": {
    "web/index.html": "text/html",
    "web/app.js": "text/javascript",
    "web/app.css": "text/css",
    "legal/Apache-2.0.txt": "text/plain",
    "legal/Croner-MIT.txt": "text/plain",
    "legal/NOTICE.md": "text/plain"
  },
  "state": [{
    "namespace": "account-scheduler",
    "schemaVersion": 1,
    "schema": { "type": "object" },
    "maximumRecords": 1,
    "maximumBytes": 262144,
    "maximumValueBytes": 262144,
    "migratesFrom": []
  }]
}
